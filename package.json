{
  "name": "dots-discord",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted Discord tools and MCP Events for dots",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "tsx src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "lint": "eslint .",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "plugin:pack": "tsx scripts/pack-plugin.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "2.1.0",
    "@modelcontextprotocol/server": "2.1.0",
    "@valibot/to-json-schema": "1.8.0",
    "discord.js": "14.27.0",
    "express": "4.22.3",
    "ipaddr.js": "2.5.0",
    "standardwebhooks": "1.1.1",
    "valibot": "1.5.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/express": "4.17.23",
    "@types/node": "24.19.0",
    "eslint": "10.11.0",
    "fflate": "0.8.2",
    "oxfmt": "0.70.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.1"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@12.6.0"
}
